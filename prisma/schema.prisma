datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  USER
}

enum TenderStatus {
  BORRADOR
  ACTIVA
  FINALIZADA
  POR_COBRAR
  COBRADA
  PERDIDA
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdTenders Tender[] @relation("TenderCreatedBy")
  updatedTenders Tender[] @relation("TenderUpdatedBy")

  createdClients Client[] @relation("ClientCreatedBy")
  updatedClients Client[] @relation("ClientUpdatedBy")

  createdProducts Product[] @relation("ProductCreatedBy")
  updatedProducts Product[] @relation("ProductUpdatedBy")

  transitionHistory TenderTransition[]
  payments          Payment[]
}

model Client {
  id          String  @id @default(uuid())
  companyName String
  contactName String?
  email       String

  createdById String
  updatedById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy User @relation("ClientCreatedBy", fields: [createdById], references: [id])
  updatedBy User @relation("ClientUpdatedBy", fields: [updatedById], references: [id])

  tenders Tender[]

  @@index([email])
}

model Product {
  id          String  @id @default(uuid())
  name        String
  description String?
  basePrice   Decimal @db.Decimal(12, 2)

  createdById String
  updatedById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy User @relation("ProductCreatedBy", fields: [createdById], references: [id])
  updatedBy User @relation("ProductUpdatedBy", fields: [updatedById], references: [id])

  tenderProducts TenderProduct[]
}

model Tender {
  id          String       @id @default(uuid())
  title       String
  description String?
  status      TenderStatus @default(BORRADOR)

  maxBudget Decimal  @db.Decimal(12, 2)
  deadline  DateTime

  proposalDocumentUrl String?
  reminderSentAt      DateTime?

  clientId    String
  createdById String
  updatedById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client    Client @relation(fields: [clientId], references: [id])
  createdBy User   @relation("TenderCreatedBy", fields: [createdById], references: [id])
  updatedBy User   @relation("TenderUpdatedBy", fields: [updatedById], references: [id])

  products          TenderProduct[]
  payments          Payment[]
  transitionHistory TenderTransition[]

  @@index([clientId])
  @@index([status])
  @@index([deadline])
}

model TenderProduct {
  id String @id @default(uuid())

  tenderId  String
  productId String

  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)

  tender  Tender  @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([tenderId, productId])
  @@index([productId])
}

model Payment {
  id String @id @default(uuid())

  tenderId    String
  createdById String

  amount      Decimal  @db.Decimal(12, 2)
  paidAt      DateTime @default(now())
  observation String?

  tender    Tender @relation(fields: [tenderId], references: [id])
  createdBy User   @relation(fields: [createdById], references: [id])

  @@index([tenderId])
}

model TenderTransition {
  id String @id @default(uuid())

  tenderId String
  userId   String

  previousStatus TenderStatus?
  newStatus      TenderStatus

  createdAt DateTime @default(now())

  tender Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenderId])
  @@index([userId])
}
